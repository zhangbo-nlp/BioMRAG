{
  "output_dir": "outputs/retriever",
  "vision_model_name_or_path": "google/vit-base-patch16-224-in21k",
  "text_model_name_or_path": "microsoft/BiomedNLP-BiomedBERT-base-uncased-abstract-fulltext",
  "tokenizer_name": "microsoft/BiomedNLP-BiomedBERT-base-uncased-abstract-fulltext",
  "image_processor_name": "google/vit-base-patch16-224-in21k",
  "projection_dim": 768,
  "freeze_vision_model": false,
  "freeze_text_model": false,
  "train_file": "data/retriever/train.jsonl",
  "validation_file": "data/retriever/validation.jsonl",
  "image_column": "image_path",
  "caption_column": "caption",
  "max_seq_length": 512,
  "remove_unused_columns": false,
  "do_train": true,
  "do_eval": true,
  "per_device_train_batch_size": 32,
  "per_device_eval_batch_size": 48,
  "gradient_accumulation_steps": 2,
  "learning_rate": 0.0001,
  "optim": "adamw_torch",
  "lr_scheduler_type": "linear",
  "warmup_ratio": 0.1,
  "weight_decay": 0.05,
  "num_train_epochs": 30,
  "preprocessing_num_workers": 8,
  "dataloader_num_workers": 8,
  "dataloader_drop_last": true,
  "logging_steps": 3000,
  "save_strategy": "epoch",
  "eval_strategy": "epoch",
  "load_best_model_at_end": true,
  "metric_for_best_model": "eval_loss",
  "tf32": true,
  "bf16": true,
  "ddp_find_unused_parameters": false,
  "seed": 42,
  "initial_temperature": 0.07,
  "expected_world_size": 4,
  "expected_effective_batch_size": 256,
  "lambda_intra": 0.6,
  "lambda_cross": 0.6,
  "fusion_text_weight": 0.6,
  "text_reconstruction": true,
  "image_reconstruction": true,
  "cross_reconstruction": true
}
